{
  "name": "fsc-pointer-playground",
  "private": true,
  "type": "module",
  "description": "Experiments toward pointer-forwarding interaction sync for FS Copilot",
  "scripts": {
    "pages": "node probes/run.mjs pages",
    "probe": "node probes/run.mjs probe",
    "eval": "node probes/run.mjs eval",
    "probe:00": "node probes/p00-debugger.mjs",
    "probe:05-server": "node probes/p05-server.mjs",
    "sources": "node probes/sources.mjs",
    "rec": "node testbed/session.mjs rec",
    "play": "node testbed/session.mjs play",
    "agent": "node testbed/session.mjs agent",
    "module:derive": "node module/tools/derive-vcockpit.mjs",
    "module:build": "node module/tools/derive-vcockpit.mjs && node module/tools/build.mjs",
    "module:check": "node module/tools/build.mjs --check",
    "module:remove": "node module/tools/build.mjs --remove",
    "host": "node host/server.mjs",
    "drift": "node probes/p10-drag-drift.mjs"
  },
  "version": "0.1.0"
}
