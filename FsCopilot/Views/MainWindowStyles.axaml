<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <Style Selector="SelectableTextBlock">
        <Setter Property="SelectionBrush" Value="Gray" />
        <Setter Property="SelectionForegroundBrush" Value="#8ec6ff" />
        <Setter Property="FontFamily" Value="Courier New"></Setter>
    </Style>

    <Style Selector="Grid.Wrapper">
        <Setter Property="Margin" Value="10, 40, 10, 10"></Setter>
        <Setter Property="RowSpacing" Value="10"></Setter>
    </Style>

    <Style Selector="Border.Card">
        <Setter Property="Background" Value="#7F000000"></Setter>
        <Setter Property="CornerRadius" Value="10"></Setter>
        <Setter Property="ClipToBounds" Value="True"></Setter>
        <Setter Property="Padding" Value="20"></Setter>
    </Style>

    <Style Selector="PathIcon.CardTitle">
        <Setter Property="Foreground" Value="#8ec6ff"></Setter>
        <Setter Property="Width" Value="15"></Setter>
        <Setter Property="Height" Value="15"></Setter>
        <Setter Property="Margin" Value="0,0,10,0"></Setter>
    </Style>

    <Style Selector="TextBlock.CardTitle">
        <Setter Property="Foreground" Value="AliceBlue"></Setter>
        <Setter Property="FontWeight" Value="Bold"></Setter>
        <Setter Property="FontSize" Value="16"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>

    <Style Selector="TextBlock.Name">
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="FontSize" Value="20"></Setter>
        <Setter Property="Foreground" Value="White"></Setter>
        <Setter Property="HorizontalAlignment" Value="Right"></Setter>
    </Style>

    <Style Selector="TextBlock.Version">
        <Setter Property="HorizontalAlignment" Value="Right"></Setter>
        <Setter Property="FontSize" Value="11"></Setter>
        <Setter Property="Foreground" Value="Gray"></Setter>
    </Style>

    <Style Selector="TextBox.Connect">
        <Setter Property="BorderThickness" Value="0"></Setter>
        <Setter Property="CornerRadius" Value="8"></Setter>
        <Setter Property="Padding" Value="10"></Setter>
    </Style>

    <Style Selector="TextBlock.JoinedSession">
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>

    <Style Selector="Border.JoinedSession">
        <Setter Property="Background" Value="#66000000"></Setter>
        <Setter Property="BorderBrush" Value="#99FFFFFF"></Setter>
        <Setter Property="CornerRadius" Value="8"></Setter>
        <Setter Property="Padding" Value="10"></Setter>
    </Style>

    <Style Selector="SelectableTextBlock.JoinedSession">
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="Foreground" Value="#8ec6ff"></Setter>
        <Setter Property="FontWeight" Value="Bold"></Setter>
        <Setter Property="FontSize" Value="16"></Setter>
    </Style>

    <Style Selector="Button.Connect">
        <Setter Property="Background" Value="#8ec6ff"></Setter>
        <Setter Property="Foreground" Value="Black"></Setter>
        <Setter Property="CornerRadius" Value="8"></Setter>
        <Setter Property="Padding" Value="10"></Setter>
        <Setter Property="Margin" Value="10,0,00,0"></Setter>
    </Style>

    <Style Selector="Button.Connect:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#5facfc"></Setter>
        <Setter Property="Foreground" Value="Black"></Setter>
    </Style>

    <Style Selector="Button.TakeControl">
        <Setter Property="Background" Value="#8ec6ff"></Setter>
        <Setter Property="Foreground" Value="Black"></Setter>
        <Setter Property="CornerRadius" Value="8"></Setter>
        <Setter Property="Padding" Value="10"></Setter>
        <Setter Property="Margin" Value="10,0,00,0"></Setter>
    </Style>

    <Style Selector="Button.TakeControl:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#5facfc"></Setter>
        <Setter Property="Foreground" Value="Black"></Setter>
    </Style>

    <Style Selector="Button.Leave">
        <Setter Property="CornerRadius" Value="8"></Setter>
        <Setter Property="Padding" Value="10"></Setter>
        <Setter Property="Margin" Value="10,0,00,0"></Setter>
        <Setter Property="Foreground" Value="White"></Setter>
    </Style>

    <Style Selector="Border.MainIcon">
        <Setter Property="Background" Value="Gray"></Setter>
        <Setter Property="CornerRadius" Value="9"></Setter>
        <Setter Property="Padding" Value="5"></Setter>
        <Setter Property="Margin" Value="0,0,10,0"></Setter>
    </Style>

    <Style Selector="Border.MainIcon > PathIcon">
        <Setter Property="Width" Value="30"></Setter>
        <Setter Property="Height" Value="30"></Setter>
        <Setter Property="Foreground" Value="White"></Setter>
    </Style>

    <Style Selector="TextBlock.ClientName">
        <Setter Property="Foreground" Value="Gray"></Setter>
    </Style>

    <Style Selector="SelectableTextBlock.PeerId">
        <Setter Property="Foreground" Value="#8ec6ff"></Setter>
        <Setter Property="FontSize" Value="16"></Setter>
    </Style>

    <Style Selector="TextBlock.Note">
        <Setter Property="Foreground" Value="#94a3b8"></Setter>
    </Style>

    <Style Selector="TextBlock.ErrorNote">
        <Setter Property="Foreground" Value="#7Fff6d6d"></Setter>
    </Style>

    <Style Selector="Border.Badge">
        <Setter Property="Padding" Value="20, 10"></Setter>
    </Style>

    <Style Selector="Border.Success">
        <Setter Property="Background" Value="DarkSeaGreen"></Setter>
    </Style>

    <Style Selector="Border.Error">
        <Setter Property="Background" Value="#7Fff6d6d"></Setter>
    </Style>

    <Style Selector="Border.Success">
        <Setter Property="Background" Value="DarkSeaGreen"></Setter>
    </Style>

    <Style Selector="Border.Info">
        <Setter Property="Background" Value="#8ec6ff"></Setter>
    </Style>

    <Style Selector="Separator">
        <Setter Property="Background" Value="Black"></Setter>
        <Setter Property="Margin" Value="10"></Setter>
    </Style>

    <Style Selector="Border.Connections">
        <Setter Property="Padding" Value="0, 20"></Setter>
    </Style>

    <Style Selector="DockPanel.ConnectionsCardTitle">
        <Setter Property="Margin" Value="20, 0, 20, 20"></Setter>
    </Style>

    <Style Selector="ScrollViewer.Connections">
        <Setter Property="AllowAutoHide" Value="True"></Setter>
        <Setter Property="Padding" Value="20, 0"></Setter>
    </Style>

    <Style Selector="ComboBox.Aircraft">
        <Setter Property="BorderThickness" Value="0"></Setter>
        <Setter Property="CornerRadius" Value="8"></Setter>
        <Setter Property="Padding" Value="10"></Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
    </Style>

    <Style Selector="TextBlock.Aircraft">
        <Setter Property="Foreground" Value="#94a3b8"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>

    <Style Selector="Border.Direct">
        <Setter Property="Background" Value="Green"></Setter>
        <Setter Property="CornerRadius" Value="7"></Setter>
        <Setter Property="Padding" Value="4, 2, 4, 2"></Setter>
    </Style>

    <Style Selector="TextBlock.Direct">
        <Setter Property="Foreground" Value="White"></Setter>
        <Setter Property="FontSize" Value="8"></Setter>
    </Style>


    <Style Selector="Border.Relay">
        <Setter Property="Background" Value="Orange"></Setter>
        <Setter Property="CornerRadius" Value="7"></Setter>
        <Setter Property="Padding" Value="4, 2, 4, 2"></Setter>
    </Style>

    <Style Selector="TextBlock.Relay">
        <Setter Property="Foreground" Value="Black"></Setter>
        <Setter Property="FontSize" Value="8"></Setter>
    </Style>

    <Style Selector="Button.Link">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#3b82f6"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- The ATC & Traffic card -->

    <Style Selector="TextBlock.ShareLabel">
        <Setter Property="Foreground" Value="AliceBlue"></Setter>
        <Setter Property="FontSize" Value="14"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>

    <Style Selector="TextBlock.ShareStatus">
        <Setter Property="Foreground" Value="#94a3b8"></Setter>
        <Setter Property="FontSize" Value="11"></Setter>
        <Setter Property="Margin" Value="0,2,0,0"></Setter>
    </Style>

    <Style Selector="ToggleSwitch.Share">
        <Setter Property="OnContent" Value=""></Setter>
        <Setter Property="OffContent" Value=""></Setter>
        <Setter Property="MinWidth" Value="0"></Setter>
        <Setter Property="Margin" Value="10,0,0,0"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Style.Resources>
            <SolidColorBrush x:Key="ToggleSwitchFillOn">#8ec6ff</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver">#5facfc</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed">#5facfc</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn">#8ec6ff</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver">#5facfc</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed">#5facfc</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn">Black</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver">Black</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed">Black</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchFillOff">#66000000</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver">#88000000</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed">#88000000</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff">#94a3b8</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver">AliceBlue</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed">AliceBlue</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff">#94a3b8</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver">AliceBlue</SolidColorBrush>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed">AliceBlue</SolidColorBrush>
        </Style.Resources>
    </Style>

    <Style Selector="ToggleSwitch.Share:disabled">
        <Setter Property="Opacity" Value="0.4"></Setter>
    </Style>

    <Style Selector="ComboBox.Share">
        <Setter Property="BorderThickness" Value="0"></Setter>
        <Setter Property="CornerRadius" Value="8"></Setter>
        <Setter Property="Padding" Value="10,6"></Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
        <Setter Property="Background" Value="#66000000"></Setter>
    </Style>

    <Style Selector="Slider.Share">
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="Margin" Value="0,0,10,0"></Setter>
        <Style.Resources>
            <SolidColorBrush x:Key="SliderTrackValueFill">#8ec6ff</SolidColorBrush>
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver">#5facfc</SolidColorBrush>
            <SolidColorBrush x:Key="SliderTrackValueFillPressed">#5facfc</SolidColorBrush>
            <SolidColorBrush x:Key="SliderTrackFill">#66000000</SolidColorBrush>
            <SolidColorBrush x:Key="SliderTrackFillPointerOver">#88000000</SolidColorBrush>
            <SolidColorBrush x:Key="SliderTrackFillPressed">#88000000</SolidColorBrush>
            <SolidColorBrush x:Key="SliderThumbBackground">#8ec6ff</SolidColorBrush>
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver">#5facfc</SolidColorBrush>
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed">#5facfc</SolidColorBrush>
        </Style.Resources>
    </Style>

    <Style Selector="Button.Icon">
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="BorderThickness" Value="0"></Setter>
        <Setter Property="Padding" Value="4"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>

    <Style Selector="Button.Icon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#33FFFFFF"></Setter>
    </Style>

    <Style Selector="Button.Icon PathIcon">
        <Setter Property="Width" Value="18"></Setter>
        <Setter Property="Height" Value="18"></Setter>
        <Setter Property="Foreground" Value="#8ec6ff"></Setter>
    </Style>

    <Style Selector="Border.Traffic, Border.Atc">
        <Setter Property="Background" Value="#8ec6ff"></Setter>
        <Setter Property="CornerRadius" Value="7"></Setter>
        <Setter Property="Padding" Value="4, 2, 4, 2"></Setter>
    </Style>

    <Style Selector="TextBlock.Traffic, TextBlock.Atc">
        <Setter Property="Foreground" Value="Black"></Setter>
        <Setter Property="FontSize" Value="8"></Setter>
    </Style>
</Styles>
