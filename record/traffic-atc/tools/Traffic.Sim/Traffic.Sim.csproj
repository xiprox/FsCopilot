<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PlatformTarget>x64</PlatformTarget>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <RootNamespace>Traffic.Sim</RootNamespace>
    </PropertyGroup>

    <!-- The managed wrapper and the native client the fork ships. Referenced in place so the
         prototype and the app can never disagree on the SimConnect version. -->
    <ItemGroup>
        <Reference Include="Microsoft.FlightSimulator.SimConnect">
            <HintPath>..\..\..\..\FsCopilot\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
        </Reference>
        <None Include="..\..\..\..\FsCopilot\SimConnect.dll">
            <Link>SimConnect.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
